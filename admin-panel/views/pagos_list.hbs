<button class="btn" onclick="history.back()">VOLVER</button>

<h1>👤 Usuarios</h1>
<h2>📓 Peticiones</h2>
<table>
  <thead>
    <tr>
      <th>Usuario</th>
      <th>Mensaje</th>
      <th>Fecha</th>
    </tr>
  </thead>
  <tbody>
    {{#each peticiones}}
    <tr>
      <td>{{username}}</td>
      <td class="precio">{{peticion}}</td>
      <td class="fecha"> {{fechaInputDateTime fecha}} </td>
    </tr>
    {{/each}}
  </tbody>

</table>


<h2>🪙 Pagos</h2>
<table>
  <thead>
    <tr>
      <th>Usuario</th>
      <th>Telegram Id</th>
      <th>Importe</th>
      <th>Fecha de Pago</th>
      <th>Acciones</th>
    </tr>
  </thead>
  <tbody>
    {{#each pagos}}
    <tr>
      <td>{{username}}</td>
      <td>{{telegram_id}}</td>
      <td class="precio">{{precio}}</td>
      <td class="fecha" data-raw="{{fechaInputDateTime fecha_pago}}"> {{formatearSp fecha_pago false}} </td>
      <td>
        <button class="btn-edit" data-id="{{id}}"> ✏️ EDITAR </button>
        <button class="btn-del-payment" data-id="{{id}}"> 🗑️ ELIMINAR </button>
      </td>
    </tr>
    {{/each}}
  </tbody>
  <tfoot>
    <tr>
      <td colspan="2"><strong>TOTAL</strong></td>
      <td><strong>{{totalPagos}} €</strong></td>
      <td colspan="2">Gastos: {{gastos}}€ </td>
    </tr>
  </tfoot>
</table>


<form action="/logout" method="POST">
  <button type="submit" class="btn-revoke">Log out</button>
</form>
<!-- MODAL -->
<div id="modal" class="modal hidden">
  <div class="modal-content">
    <p id="modal-text"></p>

    <form id="modal-form" method="POST">
      <input type="hidden" name="telegram_id" id="telegram_id">
      <input type="hidden" name="subscripcion_id" id="subscripcion_id">

      <button type="submit">Confirmar</button>
      <button type="button" onclick="closeModal()">Cancelar</button>
    </form>
  </div>
</div>

<script>
  document.querySelectorAll(".btn-edit").forEach(btn => {
    btn.addEventListener("click", function () {
      const tr = this.closest("tr");

      const tdPrecio = tr.querySelector(".precio");
      const tdFecha = tr.querySelector(".fecha");
      const acciones = this.parentElement;

      const id = this.dataset.id;

      const precioActual = tdPrecio.textContent.trim();
      const fechaActual = tdFecha.dataset.raw;

      tdPrecio.innerHTML = `<input type="number" value="${precioActual}" style="width:80px">`;
      tdFecha.innerHTML = `<input type="datetime-local" value="${fechaActual}">`;

      acciones.innerHTML = `
      <button class="btn-save">💾 Guardar</button>
      <button class="btn-cancel">❌ Cancelar</button>
    `;

      acciones.querySelector(".btn-save").addEventListener("click", async () => {
        const nuevoPrecio = tdPrecio.querySelector("input").value;
        const nuevaFecha = tdFecha.querySelector("input").value;

        try {
          const res = await fetch("/editPayment", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              id,
              precio: nuevoPrecio,
              fecha_pago: nuevaFecha
            })
          });

          if (!res.ok) throw new Error("Error al guardar");

          // actualizar fila sin reload
          tdPrecio.textContent = nuevoPrecio;
          tdFecha.textContent = nuevaFecha;

          acciones.innerHTML = `
          <button class="btn-edit" data-id="${id}"> ✏️ EDITAR </button>
          <button class="btn-del-payment" data-id="${id}"> 🗑️ ELIMINAR </button>
        `;

        } catch (err) {
          alert("Error al guardar el pago");
          console.error(err);
        }
      });

      acciones.querySelector(".btn-cancel").addEventListener("click", () => {
        location.reload(); // se puede mejorar más, pero ok temporal
      });
    });
  });
</script>